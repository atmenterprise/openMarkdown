{
  "id": "./",
  "name": "OpenMarkdown",
  "short_name": "OpenMarkdown",
  "description": "Open, preview, and edit Markdown files in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fcfcfc",
  "theme_color": "#ffde59",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./?open-file",
      "accept": { "text/markdown": [".md", ".markdown"] },
      "launch_type": "single-client"
    }
  ]
}
